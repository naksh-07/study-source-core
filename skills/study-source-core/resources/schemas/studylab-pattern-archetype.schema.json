{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyLabProblemPatternAndArchetype",
  "description": "Schema for problem patterns and archetypes used in Chapter practice profiles and pattern catalogs.",
  "type": "object",
  "required": ["patterns"],
  "properties": {
    "domain": { "type": "string", "enum": ["Mathematics", "Reasoning", "Physics", "Chemistry"] },
    "chapter": { "type": "string" },
    "skill_id": { "type": "string" },
    "error_log_taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category_id", "name"],
        "properties": {
          "category_id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "schema_id", "problem_family", "recognition_signals"],
        "properties": {
          "id": { "type": "string" },
          "schema_id": { "type": "string" },
          "problem_family": { "type": "string" },
          "recognition_signals": { "type": "array", "items": { "type": "string" } },
          "prerequisites": { "type": "array", "items": { "type": "string" }, "default": [] },
          "pyq_references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pyq_id", "exam", "year", "question", "options", "correct_option"],
              "properties": {
                "pyq_id": { "type": "string" },
                "exam": { "type": "string" },
                "year": { "type": "integer" },
                "shift": { "type": "string" },
                "question": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "correct_option": { "type": "string" },
                "explanation": { "type": "string" }
              }
            },
            "default": []
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
