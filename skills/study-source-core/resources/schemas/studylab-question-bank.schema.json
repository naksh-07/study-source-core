{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyLab Canonical Question Bank Schema",
  "description": "Authoritative machine-readable schema for procedural Question Banks preserving StudyLab semantic architecture",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "chapter",
    "questions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "domain": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "hi"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "chapter": { "type": "string" },
        "generator_version": { "type": "string" },
        "content_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern_id",
          "provenance",
          "question_type",
          "difficulty",
          "question",
          "recognition_signals",
          "expected_method",
          "decision_points",
          "trap",
          "error_category",
          "hints",
          "solution",
          "verification",
          "prerequisites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pattern_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "required": ["origin"],
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "authentic_pyq",
                  "source_derived",
                  "curated_source",
                  "derived_variant",
                  "synthetic_schema"
                ]
              },
              "source": { "type": "string" },
              "exam_metadata": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": true
          },
          "question_type": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": ["number", "string"]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "correct_answer": {},
          "correct_option": { "type": "string" },
          "answer": {},
          "recognition_signals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_method": {
            "type": "string",
            "minLength": 1
          },
          "decision_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "trap": {
            "type": ["string", "array"]
          },
          "error_category": {
            "type": "array",
            "items": { "type": "string" }
          },
          "error_categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hints": {
            "type": "object",
            "required": ["tier_1", "tier_2", "tier_3"],
            "properties": {
              "tier_1": { "type": "string", "minLength": 1 },
              "tier_2": { "type": "string", "minLength": 1 },
              "tier_3": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          },
          "solution": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
