{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Subject-aware visual rules defining preferred visual categories, occlusion defaults, and eligibility hints per subject.",
  "subjects": {
    "Biology": {
      "preferred_visual_categories": [
        "anatomical_diagram",
        "process_diagram",
        "cycle",
        "classification_diagram",
        "scientific_apparatus"
      ],
      "io_default_mode": "hide_all_guess_one",
      "high_io_worthiness": true,
      "typical_target_types": ["labels", "structures", "components", "process_stages"]
    },
    "Chemistry": {
      "preferred_visual_categories": [
        "chemical_structure",
        "reaction_scheme",
